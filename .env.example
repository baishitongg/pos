# Copy to .env and adjust. All values are optional in development.

PORT=3000
# Base URL printed inside QR codes. Use your domain in production,
# or your computer's LAN IP (e.g. http://192.168.1.20:3000) to test with a phone.
PUBLIC_URL=http://localhost:3000
# Set to 1 when running behind a reverse proxy / load balancer (uses X-Forwarded-*).
TRUST_PROXY=0
NODE_ENV=development

# REQUIRED in production: long random string (e.g. `openssl rand -base64 48`).
QR_SECRET=dev-only-qr-secret-change-me
# Demo staff passwords — the server refuses to start in production with these defaults.
ADMIN_PASSWORD=admin123
KITCHEN_PASSWORD=kitchen123
SESSION_TTL_HOURS=12

RESTAURANT_NAME=Hai Kitchen
CURRENCY=MYR
LOCALE=en-MY
TIMEZONE=Asia/Kuala_Lumpur
SERVICE_CHARGE_RATE=0.10
TAX_RATE=0.06
TAX_LABEL=SST

DATA_FILE=./data/db.json
LOG_REQUESTS=1
